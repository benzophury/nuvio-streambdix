{
  "name": "StreamBDIX Repository",
  "description": "On-device BDIX scrapers for Nuvio",
  "version": "1.0.0",
  "manifestVersion": 1,
  "scrapers": [
    {
      "id": "streambdix-plugin",
      "name": "StreamBDIX Plugin",
      "description": "BDIX LAN Sources",
      "version": "1.0.0",
      "author": "Corpse",
      "providers": [
        {
          "id": "dhakaflix",
          "name": "DhakaFlix",
          "description": "BDIX LAN Source: DhakaFlix",
          "version": "1.0.0",
          "author": "Corpse",
          "supportedTypes": [
            "movie",
            "tv"
          ],
          "filename": "providers/dhakaflix.js",
          "enabled": true,
          "logo": "",
          "contentLanguage": [
            "en",
            "bn"
          ],
          "formats": [
            "mp4",
            "mkv"
          ],
          "limited": true,
          "disabledPlatforms": [],
          "supportsExternalPlayer": true
        }
      ]
    }
  ]
}
